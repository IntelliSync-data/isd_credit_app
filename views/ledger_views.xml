<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_ledger_list" model="ir.ui.view">
        <field name="name">isd.credit.ledger.list</field>
        <field name="model">isd.credit.ledger</field>
        <field name="arch" type="xml">
            <list string="Credit Usage" create="0" edit="0" delete="0"
                  decoration-success="credits &gt; 0" decoration-muted="credits == 0">
                <field name="date"/>
                <field name="kind"/>
                <field name="description"/>
                <field name="user_id" widget="many2one_avatar_user"/>
                <field name="module_id" optional="show"/>
                <field name="res_model" optional="hide"/>
                <field name="qty" optional="hide"/>
                <field name="credits" sum="Total"/>
                <field name="system_delta" optional="hide" sum="Total"/>
                <field name="topup_delta" optional="hide" sum="Total"/>
                <field name="balance_after"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <button name="action_open_record" type="object" icon="fa-external-link" title="Open the record"
                        invisible="not res_id"/>
            </list>
        </field>
    </record>

    <record id="view_ledger_form" model="ir.ui.view">
        <field name="name">isd.credit.ledger.form</field>
        <field name="model">isd.credit.ledger</field>
        <field name="arch" type="xml">
            <form string="Credit Movement" create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="kind"/>
                            <field name="description"/>
                            <field name="user_id"/>
                            <field name="wallet_id"/>
                            <field name="topup_id" invisible="not topup_id"/>
                        </group>
                        <group>
                            <field name="rule_id" invisible="not rule_id"/>
                            <field name="res_model" invisible="not res_model"/>
                            <field name="res_id" invisible="not res_id"/>
                            <field name="qty"/>
                            <field name="credits"/>
                            <field name="system_delta"/>
                            <field name="topup_delta"/>
                            <field name="balance_after"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ledger_pivot" model="ir.ui.view">
        <field name="name">isd.credit.ledger.pivot</field>
        <field name="model">isd.credit.ledger</field>
        <field name="arch" type="xml">
            <pivot string="Credit Usage" sample="1">
                <field name="date" interval="month" type="col"/>
                <field name="kind" type="row"/>
                <field name="credits" type="measure"/>
                <field name="used" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_ledger_graph" model="ir.ui.view">
        <field name="name">isd.credit.ledger.graph</field>
        <field name="model">isd.credit.ledger</field>
        <field name="arch" type="xml">
            <graph string="Credit Usage" type="line" sample="1">
                <field name="date" interval="day"/>
                <field name="used" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ledger_search" model="ir.ui.view">
        <field name="name">isd.credit.ledger.search</field>
        <field name="model">isd.credit.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="description"/>
                <field name="user_id"/>
                <field name="rule_id"/>
                <field name="module_id"/>
                <filter name="mine" string="My Usage" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="consume" string="Used" domain="[('kind', '=', 'consume')]"/>
                <filter name="added" string="Added" domain="[('kind', '!=', 'consume')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group expand="0">
                    <filter name="group_rule" string="Action" context="{'group_by': 'rule_id'}"/>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_module" string="Module" context="{'group_by': 'module_id'}"/>
                    <filter name="group_kind" string="Type" context="{'group_by': 'kind'}"/>
                    <filter name="group_date" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ledger" model="ir.actions.act_window">
        <field name="name">Credit Usage</field>
        <field name="res_model">isd.credit.ledger</field>
        <field name="path">credit-usage</field>
        <field name="view_mode">list,graph,pivot,form</field>
    </record>

    <record id="action_my_usage" model="ir.actions.act_window">
        <field name="name">My Usage</field>
        <field name="res_model">isd.credit.ledger</field>
        <field name="path">credit-my-usage</field>
        <field name="view_mode">list,graph,form</field>
        <field name="domain">[('user_id', '=', uid), ('kind', '=', 'consume')]</field>
        <field name="context">{'search_default_date': 1}</field>
    </record>

    <!-- The monthly statement ISD bills from -->
    <record id="action_ledger_statement" model="ir.actions.act_window">
        <field name="name">Monthly Statement</field>
        <field name="res_model">isd.credit.ledger</field>
        <field name="path">credit-statement</field>
        <field name="view_mode">pivot,list,graph</field>
        <field name="context">{'pivot_row_groupby': ['date:month'], 'pivot_column_groupby': ['kind'],
                               'pivot_measures': ['credits', 'used']}</field>
    </record>
</odoo>

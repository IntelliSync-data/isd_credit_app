<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_package_list" model="ir.ui.view">
        <field name="name">isd.credit.package.list</field>
        <field name="model">isd.credit.package</field>
        <field name="arch" type="xml">
            <list string="Packages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="credits"/>
                <field name="price"/>
                <field name="currency_id" options="{'no_create': True}"/>
                <field name="description" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_package" model="ir.actions.act_window">
        <field name="name">Packages</field>
        <field name="res_model">isd.credit.package</field>
        <field name="path">credit-packages</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No top-up package yet</p>
            <p>For example 1,000 credits for 500,000 VND, or 1,000 credits for 20 USD.</p>
        </field>
    </record>
</odoo>

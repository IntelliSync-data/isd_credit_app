<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_limit_list" model="ir.ui.view">
        <field name="name">isd.credit.limit.list</field>
        <field name="model">isd.credit.limit</field>
        <field name="arch" type="xml">
            <list string="User Limits" editable="bottom">
                <field name="user_id" widget="many2one_avatar_user" options="{'no_create': True}"
                       readonly="group_id" required="not group_id"/>
                <field name="group_id" options="{'no_create': True}" readonly="user_id" required="not user_id"/>
                <field name="mode"/>
                <field name="max_credits" invisible="mode == 'forbid'"/>
                <field name="period" invisible="mode == 'forbid'"/>
                <field name="used" invisible="not user_id"/>
                <field name="remaining" invisible="not user_id or mode == 'forbid'"/>
                <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_limit_search" model="ir.ui.view">
        <field name="name">isd.credit.limit.search</field>
        <field name="model">isd.credit.limit</field>
        <field name="arch" type="xml">
            <search>
                <field name="user_id"/>
                <field name="group_id"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_limit" model="ir.actions.act_window">
        <field name="name">User Limits</field>
        <field name="res_model">isd.credit.limit</field>
        <field name="path">credit-limits</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nobody is limited</p>
            <p>Everyone draws on the shared credit. Add a line to cap an employee or a group per day, week or month,
                or to keep them from charged actions.</p>
        </field>
    </record>
</odoo>

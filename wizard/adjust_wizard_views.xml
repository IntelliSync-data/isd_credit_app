<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_adjust_wizard_form" model="ir.ui.view">
        <field name="name">isd.credit.adjust.wizard.form</field>
        <field name="model">isd.credit.adjust.wizard</field>
        <field name="arch" type="xml">
            <form string="Adjust Credit">
                <group>
                    <field name="wallet_id" readonly="1"/>
                    <field name="part" widget="radio"/>
                    <field name="credits"/>
                    <field name="reason" placeholder="Shown on the ledger"/>
                </group>
                <footer>
                    <button name="action_apply" type="object" string="Apply" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_credit" model="ir.module.category">
        <field name="name">Credit</field>
        <field name="sequence">80</field>
    </record>

    <!-- Every employee: the price list, their own usage and limit -->
    <record id="group_credit_user" model="res.groups">
        <field name="name">Credit User</field>
        <field name="category_id" ref="module_category_credit"/>
        <field name="comment">Sees what each action costs, and their own usage.</field>
    </record>
    <record id="base.group_user" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_credit_user'))]"/>
    </record>

    <!-- The customer's manager -->
    <record id="group_credit_manager" model="res.groups">
        <field name="name">Credit Manager</field>
        <field name="category_id" ref="module_category_credit"/>
        <field name="implied_ids" eval="[(4, ref('group_credit_user'))]"/>
        <field name="comment">Sees the balance and all usage, limits staff, and requests top-ups.</field>
    </record>

    <!-- ISD. Never given to the customer: this is who sets prices and approves top-ups -->
    <record id="group_credit_vendor" model="res.groups">
        <field name="name">Credit Vendor (ISD)</field>
        <field name="category_id" ref="module_category_credit"/>
        <field name="implied_ids" eval="[(4, ref('group_credit_manager'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        <field name="comment">Sets plans, prices and packages, approves top-ups, adjusts credit. Its users are never charged.</field>
    </record>

    <!-- Usage: staff see their own lines, managers their companies' -->
    <record id="rule_ledger_own" model="ir.rule">
        <field name="name">Credit ledger: own usage</field>
        <field name="model_id" ref="model_isd_credit_ledger"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('group_credit_user'))]"/>
    </record>
    <record id="rule_ledger_manager" model="ir.rule">
        <field name="name">Credit ledger: the companies' usage</field>
        <field name="model_id" ref="model_isd_credit_ledger"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_credit_manager'))]"/>
    </record>
    <record id="rule_wallet_company" model="ir.rule">
        <field name="name">Credit wallet: the companies' wallets</field>
        <field name="model_id" ref="model_isd_credit_wallet"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_limit_own" model="ir.rule">
        <field name="name">Credit limits: the ones that apply to me</field>
        <field name="model_id" ref="model_isd_credit_limit"/>
        <field name="domain_force">['|', ('user_id', '=', user.id), ('group_id', 'in', user.groups_id.ids)]</field>
        <field name="groups" eval="[(4, ref('group_credit_user'))]"/>
    </record>
    <record id="rule_limit_manager" model="ir.rule">
        <field name="name">Credit limits: all</field>
        <field name="model_id" ref="model_isd_credit_limit"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_credit_manager'))]"/>
    </record>
    <record id="rule_topup_company" model="ir.rule">
        <field name="name">Top-ups: the companies' requests</field>
        <field name="model_id" ref="model_isd_credit_topup"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>

#. module: isd_credit_app
#: model:mail.template,body_html:isd_credit_app.mail_template_credit_low
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"    <p>Hello,</p>\n"
"    <p><t t-out=\"object.display_label or ''\"/> has <strong><t t-out=\"object.balance\"/></strong> credits left.</p>\n"
"    <p>Actions that cost credit stop when it runs out. Please top up soon.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"    <p>Xin chào,</p>\n"
"    <p><t t-out=\"object.display_label or ''\"/> còn <strong><t t-out=\"object.balance\"/></strong> credit.</p>\n"
"    <p>Khi hết credit, các thao tác có tính credit sẽ bị chặn. Vui lòng nạp thêm sớm.</p>\n"
"</div>\n"
"        "

#. module: isd_credit_app
#: model:mail.template,body_html:isd_credit_app.mail_template_credit_empty
msgid ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"    <p>Hello,</p>\n"
"    <p><t t-out=\"object.display_label or ''\"/> has run out of credit.</p>\n"
"    <p>Actions that cost credit are blocked until it is topped up.</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"font-family: Arial, sans-serif; font-size: 14px;\">\n"
"    <p>Xin chào,</p>\n"
"    <p><t t-out=\"object.display_label or ''\"/> đã hết credit.</p>\n"
"    <p>Các thao tác có tính credit bị chặn cho đến khi được nạp thêm.</p>\n"
"</div>\n"
"        "

